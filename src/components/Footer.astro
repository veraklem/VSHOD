---
import { Image } from 'astro:assets'
import { site } from '../data/site'
import logo from '../assets/brand/logo-vshod.png'
import GrowthLines from './GrowthLines.astro'

const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Image src={logo} alt="ВСХОД. Наука, рост, будущее" width="120" height="117" densities={[1, 2]} loading="lazy" />
        <p class="small muted footer__claim">
          {site.claim}. Розничный бренд, разработано
          <a href={site.developerUrl} rel="noopener" target="_blank">{site.developer}</a>.
        </p>
      </div>

      <nav class="footer__nav" aria-label="Разделы сайта">
        <p class="eyebrow eyebrow--plain">Разделы</p>
        <ul class="footer__list">
          {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer__contacts">
        <p class="eyebrow eyebrow--plain">Связаться</p>
        <ul class="footer__list">
          <li><a href={`mailto:${site.contacts.email}`}>{site.contacts.email}</a></li>
          <li><a href={site.contacts.telegram} rel="noopener" target="_blank">Telegram {site.contacts.telegramHandle}</a></li>
          <li><a href={site.contacts.telegramChannel} rel="noopener" target="_blank">Telegram-канал INBIOLAB</a></li>
          {site.contacts.phone && <li><a href={`tel:${site.contacts.phone.replace(/[^+\d]/g, '')}`}>{site.contacts.phone}</a></li>}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="small muted">© {year} {site.legalName}. ВСХОД, линейка микробиологических препаратов для растений.</p>
      <p class="small muted">Сайт не собирает персональные данные и не использует cookies для отслеживания.</p>
    </div>
  </div>
  <div class="footer__lines" aria-hidden="true">
    <GrowthLines arcs={5} />
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--line);
    padding-block: var(--s-8) var(--s-6);
    background: var(--surface);
  }
  .footer__grid {
    display: grid;
    gap: var(--s-7);
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 48em) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 30em) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
  .footer__brand img {
    width: 7.5rem;
    height: auto;
  }
  .footer__claim {
    margin-top: var(--s-4);
    max-width: 30em;
  }
  .footer__list {
    list-style: none;
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }
  .footer__list a {
    text-decoration: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .footer__list a:hover {
    color: var(--forest);
    text-decoration: underline;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    justify-content: space-between;
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .footer__lines {
    position: absolute;
    right: -3rem;
    bottom: -4rem;
    width: 18rem;
    color: var(--leaf);
    z-index: -1;
    transform: scaleX(-1);
  }
</style>
