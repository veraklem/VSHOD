---
/**
 * «Линии роста» — единственный декоративный мотив сайта.
 * Тонкие концентрические дуги с точкой, как в нижнем левом углу
 * слайдов презентации. Рисуется currentColor, размер задаётся снаружи.
 */
interface Props {
  class?: string
  /** Количество дуг. */
  arcs?: number
}
const { class: className = '', arcs = 4 } = Astro.props
const R = [60, 110, 160, 210, 260].slice(0, arcs)
---

<svg
  class={`growth-lines ${className}`}
  viewBox="0 0 280 280"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {R.map((r) => <path d={`M0 ${280 - r} A ${r} ${r} 0 0 1 ${r} 280`} stroke="currentColor" stroke-width="1" />)}
  <circle cx={R[1] * 0.7071} cy={280 - R[1] * 0.7071} r="3" fill="currentColor" />
</svg>

<style>
  .growth-lines {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.55;
  }
</style>
