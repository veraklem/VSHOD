---
import { Image } from 'astro:assets'
import { site } from '../data/site'
import logo from '../assets/brand/logo-vshod.png'
import Icon from './Icon.astro'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label="ВСХОД, на главную">
      <Image src={logo} alt="ВСХОД. Наука, рост, будущее" height={44} densities={[1, 2]} loading="eager" class="brand__logo" />
    </a>

    <nav class="nav nav--desktop" aria-label="Основное меню">
      <ul class="nav__list">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contacts" class="btn btn--secondary header__cta">Связаться с нами</a>

    <!-- Мобильное меню на <details>: работает без JS и с клавиатуры. -->
    <details class="menu">
      <summary class="menu__toggle" aria-label="Открыть меню">
        <Icon name="menu" class="menu__icon menu__icon--open" />
        <Icon name="close" class="menu__icon menu__icon--close" />
      </summary>
      <nav class="menu__panel" aria-label="Мобильное меню">
        <ul class="menu__list">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="menu__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="menu__contacts">
          <a href="/contacts" class="btn">Связаться с нами</a>
          <a href={`mailto:${site.contacts.email}`} class="menu__contact">{site.contacts.email}</a>
          <a href={site.contacts.telegram} class="menu__contact" rel="noopener" target="_blank">
            Telegram {site.contacts.telegramHandle}
          </a>
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    isolation: isolate;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    margin-right: auto;
  }
  .brand__logo {
    height: 2.75rem;
    width: auto;
  }
  @media (max-width: 24em) {
    .brand__logo {
      height: 2.25rem;
    }
  }
  .nav__list {
    display: flex;
    gap: var(--s-1);
    list-style: none;
  }
  .nav__link {
    display: inline-block;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
    transition:
      color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }
  .nav__link:hover {
    color: var(--forest);
    background: var(--surface-2);
  }
  .nav__link[aria-current='page'] {
    color: var(--forest);
    box-shadow: inset 0 -2px 0 var(--leaf);
    border-radius: 0;
  }
  .menu {
    display: none;
  }

  @media (max-width: 56em) {
    .nav--desktop,
    .header__cta {
      display: none;
    }
    .menu {
      display: block;
    }
    .menu__toggle {
      list-style: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: var(--radius);
      border: 1px solid var(--line);
      background: var(--surface);
      cursor: pointer;
    }
    .menu__toggle::-webkit-details-marker {
      display: none;
    }
    .menu__icon--close,
    .menu[open] .menu__icon--open {
      display: none;
    }
    .menu[open] .menu__icon--close {
      display: block;
    }
    .menu__panel {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      z-index: var(--z-menu);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      padding: var(--s-4) var(--gutter) var(--s-6);
      box-shadow: 0 12px 32px rgba(15, 31, 21, 0.08);
    }
    .menu__list {
      list-style: none;
      display: grid;
    }
    .menu__link {
      display: block;
      padding: var(--s-3) 0;
      font-size: 1.125rem;
      font-weight: 500;
      text-decoration: none;
      border-bottom: 1px solid var(--line);
      color: var(--forest);
    }
    .menu__link[aria-current='page'] {
      color: var(--green);
    }
    .menu__contacts {
      display: grid;
      gap: var(--s-3);
      margin-top: var(--s-5);
    }
    .menu__contact {
      color: var(--ink-2);
      font-size: 0.9375rem;
    }
  }
</style>
